{:deps {org.clojure/clojure {:mvn/version "1.12.4"}
        ; logging
        org.clojure/tools.logging {:mvn/version "1.3.0"}
        ch.qos.logback/logback-classic {:mvn/version "1.5.38"}
        ; system & config
        integrant/integrant {:mvn/version "1.0.1"}
        io.github.abogoyavlensky/integrant-extras {:mvn/version "0.1.2"}
        ; server
        metosin/reitit-ring {:mvn/version "0.9.2"}
        metosin/reitit-middleware {:mvn/version "0.9.2"}
        metosin/reitit-malli {:mvn/version "0.9.2"}
        io.github.abogoyavlensky/reitit-extras {:mvn/version "0.2.3"}
        ring/ring-jetty-adapter {:mvn/version "1.15.5"}
        io.github.abogoyavlensky/manifest-edn {:mvn/version "0.1.1"}{{auth-deps}}
        ; db
        hikari-cp/hikari-cp {:mvn/version "3.3.0"}
        {{db-driver-deps}}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1086"}
        com.github.seancorfield/honeysql {:mvn/version "2.7.1364"}
        dev.weavejester/ragtime {:mvn/version "0.12.1"}
        ; Patched over what ring-jetty-adapter (Jetty 12.1.8) and jsonista (Jackson 2.18.2) bring:
        ; their releases still carry published HIGH advisories. A top-level version wins, so
        ; these hold the whole of each family on one version - move them together, and drop
        ; them when what brings them catches up.
        com.fasterxml.jackson.core/jackson-annotations {:mvn/version "2.18.11"}
        com.fasterxml.jackson.core/jackson-core {:mvn/version "2.18.11"}
        com.fasterxml.jackson.core/jackson-databind {:mvn/version "2.18.11"}
        com.fasterxml.jackson.datatype/jackson-datatype-jsr310 {:mvn/version "2.18.11"}
        org.eclipse.jetty/jetty-http {:mvn/version "12.1.14"}
        org.eclipse.jetty/jetty-io {:mvn/version "12.1.14"}
        org.eclipse.jetty/jetty-security {:mvn/version "12.1.14"}
        org.eclipse.jetty/jetty-server {:mvn/version "12.1.14"}
        org.eclipse.jetty/jetty-session {:mvn/version "12.1.14"}
        org.eclipse.jetty/jetty-unixdomain-server {:mvn/version "12.1.14"}
        org.eclipse.jetty/jetty-util {:mvn/version "12.1.14"}
        org.eclipse.jetty/jetty-xml {:mvn/version "12.1.14"}
        org.eclipse.jetty.ee/jetty-ee-webapp {:mvn/version "12.1.14"}
        org.eclipse.jetty.ee9/jetty-ee9-nested {:mvn/version "12.1.14"}
        org.eclipse.jetty.ee9/jetty-ee9-security {:mvn/version "12.1.14"}
        org.eclipse.jetty.ee9/jetty-ee9-servlet {:mvn/version "12.1.14"}
        org.eclipse.jetty.ee9/jetty-ee9-webapp {:mvn/version "12.1.14"}
        org.eclipse.jetty.ee9.websocket/jetty-ee9-websocket-jetty-api {:mvn/version "12.1.14"}
        org.eclipse.jetty.ee9.websocket/jetty-ee9-websocket-jetty-common {:mvn/version "12.1.14"}
        org.eclipse.jetty.ee9.websocket/jetty-ee9-websocket-jetty-server {:mvn/version "12.1.14"}
        org.eclipse.jetty.ee9.websocket/jetty-ee9-websocket-servlet {:mvn/version "12.1.14"}
        org.eclipse.jetty.websocket/jetty-websocket-core-common {:mvn/version "12.1.14"}
        org.eclipse.jetty.websocket/jetty-websocket-core-server {:mvn/version "12.1.14"}}

 :paths ["src" "resources"]

 :aliases {:dev {:extra-paths ["dev"]
                 :extra-deps {integrant/repl {:mvn/version "0.5.0"}
                              ring/ring-devel {:mvn/version "1.15.3"}}}

           ; A headless nREPL with no editor attached, port chosen by the OS and written to
           ; .nrepl-port: `clojure -Srepro -M:test:nrepl`. Deliberately WITHOUT the dev path:
           ; dev/user.clj is what knows how to start the system, so a REPL that cannot see it
           ; cannot start the web server or the css watcher. One per git worktree is safe.
           :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}
                                org.clojure/test.check {:mvn/version "1.1.3"}}
                   :main-opts ["-m" "nrepl.cmdline" "--port" "0"]}

           :test {:extra-paths ["test"]
                  :extra-deps {eftest/eftest {:mvn/version "0.6.0"}
                               cloverage/cloverage {:mvn/version "1.2.4"}
                               io.github.tonsky/clj-reload {:mvn/version "1.0.0"}
                               clj-http/clj-http {:mvn/version "3.13.1"}
                               circleci/bond {:mvn/version "0.6.0"}
                               org.clj-commons/hickory {:mvn/version "0.7.7"}{{db-test-deps}}}
                  :exec-fn cloverage.coverage/run-project
                  :exec-args {:test-ns-path ["test"]
                              :src-ns-path ["src"]
                              :runner :eftest
                              :runner-opts {:multithread? false}}}

           :outdated {:extra-deps {com.github.liquidz/antq {:mvn/version "2.11.1276"}}
                      :main-opts ["-m" "antq.core" "--no-diff"]}

           :build {:deps {io.github.abogoyavlensky/slim {:mvn/version "0.3.2"}}
                   :ns-default slim.app
                   :exec-args {:main-ns {{main/ns}}.core
                               :src-dirs ["src" "resources" "resources-hashed"]}}}}
